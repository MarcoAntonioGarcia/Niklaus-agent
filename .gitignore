# manifiestos, estado del MCP y la bitácora (respuestas de Claude).
/data/

# Entornos, modelos y binarios descargados (se reconstruyen con la documentación).
/venv/
/models/
/tools/deno/
__pycache__/
*.pyc

# Repos de terceros: se clonan en el commit auditado, no se copian aquí.
/skills/claude-video/
/skills/_auditoria/

# Personal / de trabajo del día a día (no es del proyecto público).
/PENDIENTES.md
/CLAUDE.md
/skills.toml
/local/
/INVENTARIO.md
.claude/settings.local.json

# Respaldos y temporales.
*.bak
*.tmp
.DS_Store

# Copias aisladas de los agentes del orquestador.
/.claude/worktrees/

# Binarios de terceros (escáneres) y auditorías de repos ajenos.
/tools/bin/
/auditorias/

# Enlaces que genera tools/skills.py aplicar (rutas absolutas de esta Mac).
/.claude/skills/
